/* Natural History menus. Reference resolution 1920x1080 (scaled with screen size). */

.root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hidden {
    display: none;
}

/* ---------- HUD ---------- */

.top-bar {
    position: absolute;
    top: 12px;
    right: 12px;
    flex-direction: row;
    align-items: center;
}

.hud-button {
    height: 40px;
    min-width: 120px;
    margin-left: 8px;
    font-size: 17px;
    color: rgb(235, 232, 220);
    background-color: rgba(28, 36, 30, 0.88);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
}

.hud-button:hover {
    background-color: rgba(52, 70, 54, 0.95);
}

.ep-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 210, 110);
    padding: 6px 12px;
    background-color: rgba(28, 36, 30, 0.88);
    border-radius: 6px;
}

/* ---------- Panels ---------- */

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.panel {
    background-color: rgb(30, 38, 32);
    border-color: rgb(110, 130, 100);
    border-width: 2px;
    border-radius: 10px;
    padding: 24px;
}

.panel-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.menu-panel {
    width: 420px;
}

.menu-button {
    height: 52px;
    margin: 6px 0;
    font-size: 20px;
    color: rgb(235, 232, 220);
    background-color: rgb(52, 66, 54);
    border-width: 0;
    border-radius: 6px;
}

.menu-button:hover {
    background-color: rgb(76, 98, 78);
}

.menu-button:disabled {
    opacity: 0.4;
}

/* ---------- Save slots ---------- */

.slots-panel {
    width: 640px;
}

.slot-list {
    margin-bottom: 12px;
}

.slot-row {
    flex-direction: row;
    align-items: center;
    height: 76px;
    margin: 5px 0;
    padding: 0 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.slot-info {
    flex-grow: 1;
}

.slot-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(235, 232, 220);
}

.slot-detail {
    font-size: 15px;
    color: rgb(170, 180, 165);
}

.slot-button {
    width: 110px;
    height: 44px;
    margin-left: 8px;
    font-size: 17px;
    color: rgb(235, 232, 220);
    background-color: rgb(70, 100, 72);
    border-width: 0;
    border-radius: 6px;
}

.slot-button:hover {
    background-color: rgb(92, 130, 94);
}

.slot-button.danger {
    background-color: rgb(110, 50, 45);
}

.slot-button.danger:hover {
    background-color: rgb(140, 64, 56);
}

/* ---------- Trees ---------- */

.tree-panel {
    width: 90%;
    height: 86%;
    padding: 16px 20px;
}

.tree-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.tree-title {
    flex-grow: 1;
    -unity-text-align: middle-left;
    margin-bottom: 0;
}

.close-button {
    width: 44px;
    height: 44px;
    margin-left: 12px;
    font-size: 22px;
    color: rgb(235, 232, 220);
    background-color: rgb(60, 50, 46);
    border-width: 0;
    border-radius: 22px;
}

.close-button:hover {
    background-color: rgb(120, 60, 52);
}

.tree-scroll {
    flex-grow: 1;
    background-color: rgb(22, 28, 24);
    border-radius: 6px;
}

.tree-canvas {
    position: relative;
}

.tree-lines {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.tree-node {
    position: absolute;
    width: 200px;
    height: 66px;
    padding: 6px 10px;
    border-width: 2px;
    border-radius: 8px;
    justify-content: center;
    background-color: rgb(46, 50, 48);
    border-color: rgb(80, 86, 82);
}

.tree-node:hover {
    border-color: rgb(230, 230, 230);
}

.tree-node.selected {
    border-color: rgb(255, 255, 255);
    border-width: 3px;
}

.tree-node.unlocked {
    background-color: rgb(52, 104, 62);
    border-color: rgb(110, 180, 110);
}

.tree-node.available {
    background-color: rgb(78, 70, 36);
    border-color: rgb(230, 190, 80);
}

.tree-node.locked {
    opacity: 0.55;
}

.node-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 238, 228);
    white-space: normal;
}

.node-cost {
    font-size: 13px;
    color: rgb(200, 200, 185);
}

.tree-details {
    flex-direction: row;
    align-items: center;
    min-height: 110px;
    margin-top: 10px;
    padding: 10px 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.details-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.details-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.details-description {
    font-size: 16px;
    color: rgb(210, 214, 200);
    white-space: normal;
}

.details-meta {
    font-size: 14px;
    color: rgb(240, 210, 110);
    white-space: normal;
    margin-top: 4px;
}

.evolve-button {
    width: 160px;
    height: 56px;
    margin-left: 16px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    background-color: rgb(70, 120, 74);
    border-width: 0;
    border-radius: 6px;
}

.evolve-button:hover {
    background-color: rgb(90, 150, 94);
}

.evolve-button:disabled {
    opacity: 0.35;
}

/* ---------- Toast ---------- */

.toast {
    position: absolute;
    bottom: 40px;
    left: 30%;
    right: 30%;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(240, 236, 220);
    padding: 10px;
    background-color: rgba(28, 36, 30, 0.92);
    border-radius: 8px;
}
