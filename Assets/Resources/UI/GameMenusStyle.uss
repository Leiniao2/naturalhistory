/* Natural History menus. Reference resolution 1920x1080 (scaled with screen size). */

.root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hidden {
    display: none;
}

/* ---------- HUD ---------- */

.top-bar {
    position: absolute;
    top: 12px;
    right: 12px;
    flex-direction: row;
    align-items: center;
}

.hud-button {
    height: 40px;
    min-width: 120px;
    margin-left: 8px;
    font-size: 17px;
    color: rgb(235, 232, 220);
    background-color: rgba(28, 36, 30, 0.88);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
}

.hud-button:hover {
    background-color: rgba(52, 70, 54, 0.95);
}

.ep-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 210, 110);
    padding: 6px 12px;
    background-color: rgba(28, 36, 30, 0.88);
    border-radius: 6px;
}

/* ---------- Admin ---------- */

.admin-bar {
    position: absolute;
    top: 62px;
    right: 12px;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(70, 24, 24, 0.9);
    border-color: rgb(170, 80, 70);
    border-width: 1px;
    border-radius: 6px;
}

.admin-tag {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 196, 150);
    margin-right: 8px;
}

.admin-age {
    margin: 0;
    min-width: 240px;
}

.admin-age > Label {
    min-width: 0;
    margin-right: 8px;
    font-size: 15px;
    color: rgb(235, 232, 220);
}

.admin-age .unity-base-field__input {
    font-size: 15px;
    min-height: 26px;
}

/* ---------- Panels ---------- */

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.panel {
    background-color: rgb(30, 38, 32);
    border-color: rgb(110, 130, 100);
    border-width: 2px;
    border-radius: 10px;
    padding: 24px;
}

.panel-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.menu-panel {
    width: 420px;
}

.menu-button {
    height: 52px;
    margin: 6px 0;
    font-size: 20px;
    color: rgb(235, 232, 220);
    background-color: rgb(52, 66, 54);
    border-width: 0;
    border-radius: 6px;
}

.menu-button:hover {
    background-color: rgb(76, 98, 78);
}

.menu-button:disabled {
    opacity: 0.4;
}

.language-dropdown {
    margin: 14px 0 0 0;
}

.language-dropdown > Label {
    min-width: 0;
    margin-right: 12px;
    font-size: 17px;
    color: rgb(235, 232, 220);
}

.language-dropdown .unity-base-field__input {
    font-size: 17px;
    min-height: 32px;
}

/* ---------- Save slots ---------- */

.slots-panel {
    width: 640px;
}

.slot-list {
    margin-bottom: 12px;
}

.slot-row {
    flex-direction: row;
    align-items: center;
    height: 76px;
    margin: 5px 0;
    padding: 0 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.slot-info {
    flex-grow: 1;
}

.slot-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(235, 232, 220);
}

.slot-detail {
    font-size: 15px;
    color: rgb(170, 180, 165);
}

.slot-button {
    width: 110px;
    height: 44px;
    margin-left: 8px;
    font-size: 17px;
    color: rgb(235, 232, 220);
    background-color: rgb(70, 100, 72);
    border-width: 0;
    border-radius: 6px;
}

.slot-button:hover {
    background-color: rgb(92, 130, 94);
}

.slot-button.danger {
    background-color: rgb(110, 50, 45);
}

.slot-button.danger:hover {
    background-color: rgb(140, 64, 56);
}

/* ---------- Trees ---------- */

.tree-panel {
    width: 98%;
    height: 96%;
    padding: 12px 18px;
}

.tree-progress {
    font-size: 16px;
    color: rgb(180, 190, 172);
    margin-right: 12px;
}

.tree-branches-scroll {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.tree-branches {
    flex-direction: row;
}

.branch-tab {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 150px;
    height: 54px;
    margin: 0 4px 0 0;
    padding: 2px 12px;
    color: rgb(225, 228, 215);
    background-color: rgb(40, 50, 42);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
}

.branch-tab:hover {
    background-color: rgb(56, 70, 58);
}

.branch-tab.selected {
    background-color: rgb(63, 92, 62);
    border-bottom-color: rgb(240, 210, 110);
}

.branch-tab-name {
    font-size: 16px;
    -unity-font-style: bold;
}

.branch-tab-count {
    font-size: 13px;
    color: rgb(180, 190, 172);
}

.branch-tab.has-available .branch-tab-count {
    color: rgb(240, 210, 110);
}

.node-external {
    font-size: 11px;
    color: rgb(230, 170, 110);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tree-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.tree-title {
    flex-grow: 1;
    -unity-text-align: middle-left;
    margin-bottom: 0;
}

.close-button {
    width: 44px;
    height: 44px;
    margin-left: 12px;
    font-size: 22px;
    color: rgb(235, 232, 220);
    background-color: rgb(60, 50, 46);
    border-width: 0;
    border-radius: 22px;
}

.close-button:hover {
    background-color: rgb(120, 60, 52);
}

.tree-scroll {
    flex-grow: 1;
    background-color: rgb(22, 28, 24);
    border-radius: 6px;
}

.tree-canvas {
    position: relative;
}

.tree-lines {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.tree-node {
    position: absolute;
    width: 206px;
    height: 74px;
    padding: 4px 10px;
    border-width: 2px;
    border-radius: 8px;
    justify-content: center;
    background-color: rgb(46, 50, 48);
    border-color: rgb(80, 86, 82);
}

.tree-node:hover {
    border-color: rgb(230, 230, 230);
}

.tree-node.selected {
    border-color: rgb(255, 255, 255);
    border-width: 3px;
}

.tree-node.unlocked {
    background-color: rgb(52, 104, 62);
    border-color: rgb(110, 180, 110);
}

.tree-node.available {
    background-color: rgb(78, 70, 36);
    border-color: rgb(230, 190, 80);
}

.tree-node.locked {
    opacity: 0.55;
}

.node-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 238, 228);
    white-space: normal;
}

.node-cost {
    font-size: 13px;
    color: rgb(200, 200, 185);
}

.tree-details {
    flex-direction: row;
    align-items: center;
    min-height: 110px;
    margin-top: 10px;
    padding: 10px 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.details-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.details-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.details-description {
    font-size: 16px;
    color: rgb(210, 214, 200);
    white-space: normal;
}

.details-meta {
    font-size: 14px;
    color: rgb(240, 210, 110);
    white-space: normal;
    margin-top: 4px;
}

.evolve-button {
    width: 160px;
    height: 56px;
    margin-left: 16px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    background-color: rgb(70, 120, 74);
    border-width: 0;
    border-radius: 6px;
}

.evolve-button:hover {
    background-color: rgb(90, 150, 94);
}

.evolve-button:disabled {
    opacity: 0.35;
}

/* ---------- Date bar ---------- */

.date-bar {
    position: absolute;
    top: 12px;
    left: 35%;
    right: 35%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.age-button {
    min-width: 280px;
    height: 66px;
    padding: 8px 24px;
    background-color: rgba(28, 36, 30, 0.9);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.age-button:hover {
    background-color: rgba(52, 70, 54, 0.95);
}

.age-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.date-label {
    margin-top: 2px;
    font-size: 14px;
    color: rgb(190, 200, 180);
}

.end-turn-button {
    height: 66px;
    min-width: 170px;
    margin-left: 10px;
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(70, 120, 74);
    border-width: 0;
    border-radius: 6px;
}

.end-turn-button:hover {
    background-color: rgb(90, 150, 94);
}

.end-turn-button:disabled {
    opacity: 0.35;
}

/* ---------- Info panels ---------- */

.info-panel {
    position: absolute;
    bottom: 12px;
    width: 300px;
    padding: 10px 14px;
    background-color: rgba(28, 36, 30, 0.9);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
}

/* ---------- Minimap ---------- */

.minimap-dock {
    position: absolute;
    left: 12px;
    bottom: 12px;
    align-items: flex-start;
}

.layer-switch {
    flex-direction: row;
    margin: 0 0 6px 0;
}

.layer-button {
    min-width: 96px;
    margin: 0 6px 0 0;
}

.layer-button.selected {
    background-color: rgb(70, 110, 80);
    border-color: rgb(170, 210, 150);
}

.minimap {
    width: 300px;
    height: 200px;
    overflow: hidden;
    background-color: rgb(10, 14, 12);
    border-color: rgb(110, 130, 100);
    border-width: 2px;
    border-radius: 4px;
    -unity-background-scale-mode: stretch-to-fill;
}

.minimap-view {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* Right column: animal card over the tile panel, both growing upward from the bottom corner */
.right-dock {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 300px;
    flex-direction: column;
    justify-content: flex-end;
}

.right-dock > .info-panel,
.animal-box > .info-panel {
    position: relative;
    bottom: auto;
}

.animal-box {
    margin-bottom: 8px;
}

/* Tabs sit on the card's top edge, joined to it */
.animal-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 6px;
}

.animal-tab {
    margin: 0 2px -1px 0;
    padding: 3px 8px;
    font-size: 13px;
    color: rgb(190, 200, 180);
    background-color: rgba(20, 26, 22, 0.9);
    border-color: rgb(110, 130, 100);
    border-width: 1px 1px 0 1px;
    border-radius: 6px 6px 0 0;
}

.animal-tab:hover {
    color: rgb(240, 236, 220);
}

.animal-tab.selected {
    color: rgb(240, 210, 110);
    background-color: rgba(28, 36, 30, 0.95);
    -unity-font-style: bold;
}

.animal-panel.tabbed {
    border-top-left-radius: 0;
}

.animal-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.animal-portrait {
    width: 64px;
    height: 64px;
    margin-right: 10px;
}

.animal-names {
    flex-shrink: 1;
    flex-grow: 1;
}

.animal-meta {
    font-size: 13px;
    color: rgb(240, 210, 110);
    white-space: normal;
}

.info-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    margin-bottom: 4px;
}

.info-zone {
    font-size: 16px;
    color: rgb(240, 210, 110);
    margin-bottom: 4px;
}

.info-stats {
    font-size: 15px;
    color: rgb(215, 220, 205);
    white-space: normal;
}

.info-note {
    font-size: 13px;
    -unity-font-style: italic;
    color: rgb(170, 185, 165);
    white-space: normal;
    margin-top: 4px;
}

/* ---------- Geologic timeline ---------- */

.age-panel {
    width: 80%;
    height: 82%;
    padding: 16px 20px;
}

.age-body {
    flex-grow: 1;
    flex-direction: row;
}

.age-list {
    width: 320px;
    margin-right: 14px;
}

.age-row {
    height: 58px;
    margin: 3px 0;
    padding: 4px 12px;
    justify-content: center;
    border-radius: 6px;
    border-left-width: 8px;
    background-color: rgb(40, 50, 42);
}

.age-row:hover {
    background-color: rgb(56, 70, 58);
}

.age-row.past {
    opacity: 0.7;
}

.age-row.future {
    opacity: 0.45;
}

.age-row.current {
    background-color: rgb(70, 92, 66);
}

.age-row.selected {
    border-right-width: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.age-row-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.age-row-range {
    font-size: 13px;
    color: rgb(180, 190, 172);
}

.age-details {
    flex-grow: 1;
    padding: 6px 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.age-name {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.age-range {
    font-size: 15px;
    color: rgb(240, 210, 110);
    margin-bottom: 8px;
}

.age-description {
    font-size: 17px;
    color: rgb(220, 224, 210);
    white-space: normal;
    margin-bottom: 8px;
}

.age-section {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(170, 210, 160);
    margin-top: 8px;
}

.age-text {
    font-size: 15px;
    color: rgb(210, 214, 200);
    white-space: normal;
}

/* ---------- Players ---------- */

.players-bar {
    position: absolute;
    top: 12px;
    left: 12px;
    flex-direction: column;
    align-items: flex-start;
}

.player-chip {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin: 0 0 4px 0;
    padding: 0 12px 0 6px;
    background-color: rgba(28, 36, 30, 0.88);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
}

.player-chip:hover {
    background-color: rgba(52, 70, 54, 0.95);
}

.player-chip.human {
    border-color: rgb(240, 210, 110);
    border-width: 2px;
}

.player-chip-name {
    font-size: 16px;
    color: rgb(235, 232, 220);
    margin-left: 8px;
}

.player-chip-tag {
    font-size: 12px;
    color: rgb(240, 210, 110);
    margin-left: 6px;
}

/* Two-colour band: primary over secondary */
.band {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    overflow: hidden;
    border-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
}

.band-half {
    flex-grow: 1;
}

.band-large {
    width: 40px;
    height: 40px;
    margin-right: 14px;
}

.faction-panel {
    width: 900px;
    height: 80%;
    padding: 16px 20px;
}

.faction-animals {
    flex-grow: 1;
    margin-top: 6px;
}

.animal-row {
    margin: 4px 0;
    padding: 8px 12px;
    border-radius: 6px;
    border-left-width: 6px;
    border-left-color: rgb(90, 100, 90);
    background-color: rgb(40, 50, 42);
}

.animal-row.active {
    border-left-color: rgb(120, 200, 110);
    background-color: rgb(50, 68, 50);
}

.animal-row.inactive {
    opacity: 0.6;
}

.animal-header {
    flex-direction: row;
    align-items: center;
}

.animal-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.animal-scientific {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(190, 200, 180);
    margin-left: 8px;
    flex-grow: 1;
}

.animal-status {
    font-size: 14px;
    color: rgb(240, 210, 110);
}

.animal-description {
    font-size: 15px;
    color: rgb(210, 214, 200);
    white-space: normal;
    margin-top: 2px;
}

/* ---------- New game ---------- */

.setup-panel {
    width: 1560px;
    max-width: 96%;
    height: 90%;
}

.setup-count-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.setup-count-label {
    font-size: 20px;
    color: rgb(235, 232, 220);
    margin-right: 12px;
}

.count-button {
    width: 40px;
    height: 40px;
    font-size: 22px;
    color: rgb(235, 232, 220);
    background-color: rgb(52, 66, 54);
    border-width: 0;
    border-radius: 6px;
}

.count-button:hover {
    background-color: rgb(76, 98, 78);
}

.setup-count {
    width: 48px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 210, 110);
    -unity-text-align: middle-center;
}

.spacer {
    flex-grow: 1;
}

.setup-list {
    flex-shrink: 1;
    max-height: 600px;
}

.setup-row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin: 3px 0;
    padding: 0 10px;
    border-radius: 6px;
    background-color: rgb(40, 50, 42);
}

.setup-seat {
    width: 70px;
    font-size: 16px;
    color: rgb(240, 210, 110);
}

.setup-band {
    width: 36px;
    height: 36px;
    margin: 0 12px 0 0;
    padding: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    overflow: hidden;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
}

.setup-faction {
    width: 260px;
    margin-right: 12px;
    font-size: 16px;
}

.setup-name {
    flex-grow: 1;
    margin-right: 12px;
    font-size: 16px;
}

.setup-category {
    width: 130px;
    font-size: 13px;
    color: rgb(180, 190, 172);
}

.setup-hint {
    font-size: 14px;
    color: rgb(170, 185, 165);
    white-space: normal;
    margin: 8px 0;
}

.setup-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.setup-action {
    width: 180px;
    margin-left: 10px;
}

.setup-action.start {
    background-color: rgb(63, 122, 68);
}

.setup-action.start:hover {
    background-color: rgb(80, 150, 85);
}

/* ---------- Toast ---------- */

.toast {
    position: absolute;
    bottom: 40px;
    left: 30%;
    right: 30%;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(240, 236, 220);
    padding: 10px;
    background-color: rgba(28, 36, 30, 0.92);
    border-radius: 8px;
}

/* ---------- Species portraits (SpeciesPortraits renders them from the map models) ---------- */

.species-portrait {
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    flex-shrink: 0;
}

/* Under the header of the Functions, Behaviors and Evolution Tree panels: a tab per species of
   yours (SpeciesTabs), the one whose trees are open lit in gold */
.species-tabs-scroll {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.species-tabs {
    flex-direction: row;
}

.species-tab {
    flex-direction: row;
    align-items: center;
    height: 52px;
    margin: 0 6px 0 0;
    padding: 3px 14px 3px 3px;
    color: rgb(220, 214, 190);
    background-color: rgba(22, 29, 25, 0.93);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.45);
    border-radius: 4px;
}

.species-tab:hover {
    background-color: rgba(44, 58, 46, 0.97);
    border-color: rgba(222, 192, 124, 0.8);
}

.species-tab.selected {
    color: rgb(242, 214, 130);
    background-color: rgba(52, 70, 50, 0.98);
    border-width: 2px;
    border-color: rgb(222, 192, 124);
}

.species-tab-portrait {
    width: 44px;
    height: 44px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.6);
    border-radius: 3px;
}

.species-tab-name {
    font-size: 17px;
    -unity-font-style: bold;
}

.tree-node.unavailable {
    opacity: 0.25;
}

/* ---------- Selected animal ---------- */

/* the selected animal's panel and the turn button side by side at the bottom centre */
.unit-dock {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.unit-panel {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(28, 36, 30, 0.92);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 8px;
}

.unit-portrait {
    width: 96px;
    height: 96px;
    margin-right: 14px;
}

.unit-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.unit-detail {
    font-size: 14px;
    color: rgb(190, 198, 182);
    margin-bottom: 6px;
}

.unit-actions {
    flex-direction: row;
}

.unit-button {
    height: 36px;
    min-width: 104px;
    margin: 0 6px 0 0;
    font-size: 15px;
    color: rgb(235, 232, 220);
    background-color: rgb(52, 66, 54);
    border-width: 0;
    border-radius: 6px;
}

.unit-button:hover {
    background-color: rgb(76, 98, 78);
}

.unit-button:disabled {
    opacity: 0.4;
}

.unit-evolve.ready {
    background-color: rgb(150, 112, 30);
    color: rgb(255, 245, 210);
}

/* ---------- Zoology ---------- */

.zoology-body {
    flex-grow: 1;
    flex-direction: row;
}

.zoology-details {
    width: 420px;
    margin-left: 12px;
    padding: 10px 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.zoology-detail-head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.zoology-detail-names {
    flex-grow: 1;
    flex-shrink: 1;
}

.zoology-encyclopedia {
    flex-shrink: 0;
    margin: 4px 0 0 8px;
}

.zoology-node {
    position: absolute;
    width: 290px;   /* ZoologyPanel.NodeWidth / NodeHeight */
    height: 86px;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px 4px 4px;
    border-width: 2px;
    border-radius: 8px;
    background-color: rgb(46, 50, 48);
    border-color: rgb(80, 86, 82);
}

.zoology-node:hover {
    border-color: rgb(230, 230, 230);
}

.zoology-node.selected {
    border-color: rgb(255, 255, 255);
    border-width: 3px;
}

.zoology-node.owned {
    background-color: rgb(52, 104, 62);
    border-color: rgb(110, 180, 110);
}

.zoology-node.ready {
    background-color: rgb(78, 70, 36);
    border-color: rgb(230, 190, 80);
}

.zoology-node.ancestor {
    opacity: 0.6;
}

/* a major group (class, phylum...): click to open its own tree */
/* a species where the view stops: its lineage carries on beyond, a click away */
.zoology-more {
    border-right-width: 4px;
    border-right-color: rgb(110, 150, 190);
}

.node-more {
    font-size: 12px;
    color: rgb(150, 190, 230);
}

.zoology-clade {
    background-color: rgb(38, 52, 66);
    border-color: rgb(110, 150, 190);
    border-width: 2px;
    border-radius: 14px;
}

.zoology-clade:hover {
    background-color: rgb(50, 70, 90);
    border-color: rgb(200, 225, 250);
}

.zoology-back {
    margin-left: 0;
    margin-right: 12px;
}

.zoology-node-portrait {
    width: 64px;
    height: 64px;
    margin-right: 8px;
}

.zoology-node-text {
    flex-shrink: 1;
    flex-grow: 1;
    overflow: hidden;
}

/* names and status may take two lines rather than run out of the node */
.zoology-node .node-name {
    white-space: normal;
}

.zoology-node .node-cost {
    font-size: 12px;
    white-space: normal;
}

.zoology-from {
    font-size: 15px;
    color: rgb(200, 205, 190);
    margin: 6px 0;
    white-space: normal;
}

.zoology-link {
    margin-top: 10px;
    padding: 10px;
    background-color: rgb(30, 38, 32);
    border-radius: 6px;
}

.zoology-link-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.zoology-link-portrait {
    width: 48px;
    height: 48px;
    margin-right: 10px;
}

.zoology-link-name {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.zoology-link-text {
    font-size: 13px;
    color: rgb(185, 192, 178);
    white-space: normal;
    margin-bottom: 4px;
}

.zoology-req {
    font-size: 14px;
    white-space: normal;
}

.zoology-req.met {
    color: rgb(140, 210, 140);
}

.zoology-req.unmet {
    color: rgb(230, 150, 120);
}

.zoology-evolve {
    margin-top: 8px;
    align-self: stretch;
}

/* ---------- New game options (NewGameOptions) ---------- */

.setup-options {
    margin: 6px 0 10px 0;
    padding: 8px 10px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.setup-option-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin: 4px 0;
}

.setup-option-label {
    width: 150px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(235, 232, 220);
}

.setup-option-group {
    flex-direction: row;
}

.setup-option {
    min-width: 96px;
    height: 32px;
    margin: 0 4px 0 0;
    font-size: 14px;
    color: rgb(225, 228, 215);
    background-color: rgb(52, 66, 54);
    border-width: 0;
    border-radius: 5px;
}

.setup-option:hover {
    background-color: rgb(76, 98, 78);
}

.setup-option.selected {
    background-color: rgb(150, 112, 30);
    color: rgb(255, 245, 210);
}

.setup-option-dropdown {
    min-width: 300px;
    margin: 0 8px 0 0;
}

.setup-option-note {
    font-size: 13px;
    color: rgb(185, 192, 178);
    margin-left: 8px;
    white-space: normal;
}

/* ---------- Frames ----------
   Brass-trimmed frames for the menus, HUD and buttons: 9-sliced textures in Frames/ (made by
   tools/ui/make_frames.py at 2x, hence the slice scales). Later rules here override the plain
   colours above; the fill is part of each texture, so background colour and borders go. */

.panel {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 28px;
    background-image: url("Frames/panel.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.75px;
}

.tree-panel,
.age-panel,
.faction-panel {
    padding: 22px 28px;
}

.panel-title {
    color: rgb(242, 226, 178);
    letter-spacing: 1px;
    text-shadow: 0 2px 2px rgba(0, 0, 0, 0.7);
}

/* the centred titles sit on an ornamented brass rule */
.menu-panel > .panel-title,
.slots-panel > .panel-title,
.setup-panel > .panel-title {
    padding-bottom: 22px;
    background-image: url("Frames/divider.png");
    background-size: 320px 20px;
    background-position-x: center;
    background-position-y: bottom;
    background-repeat: no-repeat;
}

/* the left-aligned headers are ruled off from the content below */
.tree-header {
    padding-bottom: 10px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(190, 154, 88, 0.4);
}

/* HUD cards: info panels, selected animal, period, EP, players, toast */
.info-panel,
.unit-panel,
.age-button,
.ep-label,
.player-chip,
.toast {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("Frames/hud.png");
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.5px;
}

.info-panel {
    padding: 12px 16px;
}

.age-button:hover,
.age-button:active,
.player-chip:hover {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Frames/hud-hover.png");
}

.player-chip.human {
    border-width: 0;
    background-image: url("Frames/hud-gold.png");
}

.player-chip {
    padding: 0 14px 0 8px;
}

.age-label,
.info-title,
.unit-name {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
}

/* Buttons */
.hud-button,
.menu-button,
.slot-button,
.unit-button,
.count-button,
.setup-option,
.close-button,
.end-turn-button,
.evolve-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(242, 236, 218);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.75);
    background-image: url("Frames/button.png");
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.5px;
}

.hud-button:hover,
.menu-button:hover,
.slot-button:hover,
.unit-button:hover,
.count-button:hover,
.setup-option:hover,
.close-button:hover {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Frames/button-hover.png");
}

.hud-button:active,
.menu-button:active,
.slot-button:active,
.unit-button:active,
.count-button:active,
.setup-option:active,
.close-button:active,
.end-turn-button:active,
.evolve-button:active {
    background-color: rgba(0, 0, 0, 0);
    translate: 0 1px;
}

.end-turn-button,
.evolve-button,
.setup-action.start {
    color: rgb(255, 255, 255);
    background-image: url("Frames/button-primary.png");
}

.end-turn-button:hover,
.evolve-button:hover,
.setup-action.start:hover {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Frames/button-primary-hover.png");
}

.layer-button.selected,
.setup-option.selected,
.unit-evolve.ready {
    color: rgb(255, 246, 214);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Frames/button-gold.png");
}

.layer-button.selected:hover,
.setup-option.selected:hover,
.unit-evolve.ready:hover {
    background-image: url("Frames/button-gold-hover.png");
}

.slot-button.danger {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Frames/button-danger.png");
}

.slot-button.danger:hover {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Frames/button-danger-hover.png");
}

.close-button {
    font-size: 20px;
}

.menu-button {
    letter-spacing: 1px;
}

/* Sunken sections inside the panels */
.tree-scroll,
.tree-details,
.age-details,
.zoology-details,
.setup-options,
.zoology-link {
    background-color: rgba(6, 10, 8, 0.55);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.25);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
}

.slot-row,
.setup-row {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.2);
    border-radius: 4px;
}

.age-row,
.animal-row {
    background-color: rgba(255, 255, 255, 0.05);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(190, 154, 88, 0.2);
    border-right-color: rgba(190, 154, 88, 0.2);
    border-bottom-color: rgba(190, 154, 88, 0.2);
    border-radius: 4px;
}

.age-row:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.age-row.current {
    background-color: rgba(120, 160, 100, 0.3);
}

.animal-row.active {
    background-color: rgba(120, 180, 100, 0.16);
}

.branch-tab {
    background-color: rgba(255, 255, 255, 0.05);
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(190, 154, 88, 0.25);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 6px 6px 2px 2px;
}

.branch-tab:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.branch-tab.selected {
    background-color: rgba(120, 160, 100, 0.32);
    border-color: rgb(210, 176, 104);
    border-bottom-color: rgb(240, 210, 110);
}

/* Animal tabs on the card's top edge */
.animal-tab {
    margin: 0 2px 0 0;
    color: rgb(200, 190, 160);
    background-color: rgba(22, 29, 25, 0.93);
    border-color: rgba(190, 154, 88, 0.7);
}

.animal-tab.selected {
    color: rgb(242, 214, 130);
    background-color: rgba(44, 58, 46, 0.97);
    border-color: rgb(222, 192, 124);
}

/* Minimap in a brass bezel */
.minimap {
    border-width: 3px;
    border-color: rgb(176, 142, 80);
    border-top-color: rgb(222, 192, 124);
    border-bottom-color: rgb(110, 86, 46);
    border-radius: 3px;
}

/* Scroll bars in the frames' brass and dark green: a slim sunken track edged in gold, a gold
   thumb that brightens under the mouse, no arrow buttons (Evolution Tree, Functions, Behaviors
   and the other scrolling lists) */
.root .unity-scroller {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.root .unity-scroller--vertical {
    width: 14px;
    min-width: 14px;
    margin-left: 4px;
}

.root .unity-scroller--horizontal {
    height: 14px;
    min-height: 14px;
    margin-top: 4px;
}

.root .unity-scroller__low-button,
.root .unity-scroller__high-button {
    display: none;
}

.root .unity-scroller > .unity-scroller__slider {
    flex-grow: 1;
    margin: 0;
}

.root .unity-scroller .unity-base-slider__drag-container {
    margin: 0;
}

.root .unity-scroller .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin: 0;
    background-color: rgba(6, 10, 8, 0.75);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.45);
    border-top-color: rgba(0, 0, 0, 0.7);
    border-radius: 7px;
}

.root .unity-scroller .unity-base-slider__dragger {
    position: absolute;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("Frames/button-gold.png");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 0.4px;
}

.root .unity-scroller--vertical .unity-base-slider__dragger {
    left: 2px;
    width: 10px;
    min-height: 28px;
}

.root .unity-scroller--horizontal .unity-base-slider__dragger {
    top: 2px;
    height: 10px;
    min-width: 28px;
}

.root .unity-scroller .unity-base-slider__dragger:hover,
.root .unity-scroller .unity-base-slider__dragger:active {
    background-image: url("Frames/button-gold-hover.png");
}

.root .unity-scroller .unity-base-slider__dragger-border {
    display: none;
}

/* the square where a vertical and a horizontal bar meet */
.root .unity-scroll-view__horizontal-scroller {
    margin-right: 0;
}

/* ---------- Encyclopedia ---------- */

.encyclopedia-search {
    width: 320px;
    margin-right: 12px;
    font-size: 17px;
}

.encyclopedia-search .unity-text-field__input {
    padding: 6px 10px;
    color: rgb(235, 228, 205);
    background-color: rgba(6, 10, 8, 0.75);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.55);
    border-radius: 4px;
}

.encyclopedia-body {
    flex-grow: 1;
    flex-direction: row;
}

/* the periods down the left: each lists the species alive in it */
.encyclopedia-periods {
    width: 150px;
    flex-shrink: 0;
    margin-right: 8px;
}

.encyclopedia-periods.collapsed {
    width: 34px;
}

.encyclopedia-period-fold {
    margin: 0 0 3px 0;
    padding: 4px 0;
    font-size: 13px;
    color: rgb(215, 205, 175);
    background-color: rgba(6, 10, 8, 0.55);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.25);
    border-radius: 4px;
}

.encyclopedia-period-fold:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.encyclopedia-period {
    flex-direction: row;
    justify-content: space-between;
    margin: 0 0 3px 0;
    padding: 6px 10px;
    font-size: 15px;
    color: rgb(215, 205, 175);
    background-color: rgba(6, 10, 8, 0.55);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.25);
    border-radius: 4px;
}

.encyclopedia-period:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.encyclopedia-period.selected {
    color: rgb(250, 240, 210);
    background-color: rgba(190, 154, 88, 0.32);
    border-color: rgba(190, 154, 88, 0.8);
}

.encyclopedia-period.empty {
    color: rgba(215, 205, 175, 0.4);
}

.encyclopedia-period-count {
    font-size: 13px;
    color: rgba(215, 205, 175, 0.65);
    margin-left: 6px;
}

.encyclopedia-list {
    width: 380px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: rgba(6, 10, 8, 0.55);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.25);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
}

.encyclopedia-list .unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
}

.encyclopedia-list .unity-list-view__item:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.encyclopedia-list .unity-collection-view__item--selected,
.encyclopedia-list .unity-collection-view__item--selected:hover {
    background-color: rgba(190, 154, 88, 0.28);
}

.encyclopedia-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px 4px 6px;
}

.encyclopedia-thumb {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.5);
    border-radius: 3px;
}

.encyclopedia-row-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.encyclopedia-row-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(232, 226, 205);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.encyclopedia-row-age {
    font-size: 13px;
    color: rgb(170, 178, 160);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.encyclopedia-row.owned .encyclopedia-row-name {
    color: rgb(150, 210, 140);
}

.encyclopedia-entry {
    flex-grow: 1;
    padding: 14px 18px;
    background-color: rgba(6, 10, 8, 0.55);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.25);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
}

.encyclopedia-top {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 14px;
}

/* the painting, in a brass frame like the minimap's */
.encyclopedia-painting {
    width: 440px;
    height: 440px;
    flex-shrink: 0;
    margin-right: 22px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 3px;
    border-color: rgb(176, 142, 80);
    border-top-color: rgb(222, 192, 124);
    border-bottom-color: rgb(110, 86, 46);
    border-radius: 3px;
}

.encyclopedia-painting.model-only {
    -unity-background-scale-mode: scale-to-fit;
}

.encyclopedia-facts {
    flex-grow: 1;
    flex-shrink: 1;
}

.encyclopedia-name {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(242, 214, 130);
    white-space: normal;
}

.encyclopedia-scientific {
    font-size: 19px;
    -unity-font-style: italic;
    color: rgb(200, 196, 176);
    margin-bottom: 14px;
}

.encyclopedia-stats {
    font-size: 17px;
    color: rgb(222, 218, 200);
    white-space: normal;
    margin-bottom: 16px;
}

.encyclopedia-tree-button {
    align-self: flex-start;
    margin-left: 0;
}

.encyclopedia-description {
    font-size: 18px;
    color: rgb(228, 224, 208);
    white-space: normal;
    margin-bottom: 12px;
}

.encyclopedia-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.encyclopedia-chip {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin: 0 8px 8px 0;
    padding: 2px 12px 2px 2px;
    color: rgb(225, 220, 198);
    background-color: rgba(22, 29, 25, 0.93);
    border-width: 1px;
    border-color: rgba(190, 154, 88, 0.45);
    border-radius: 4px;
}

.encyclopedia-chip:hover {
    color: rgb(242, 214, 130);
    border-color: rgb(222, 192, 124);
}

.encyclopedia-chip-thumb {
    width: 38px;
    height: 38px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 3px;
}

.encyclopedia-chip-name {
    font-size: 15px;
}

/* End Turn reads "Next animal (n)" while your animals await orders (UnitCycle) */
.end-turn-button.next-unit {
    background-image: url("Frames/button-gold.png");
    color: rgb(255, 246, 214);
}

.end-turn-button.next-unit:hover {
    background-image: url("Frames/button-gold-hover.png");
}

/* ---------- Title screen (MainMenu.cs) ---------- */

.main-menu {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
    background-color: rgb(10, 12, 10);
}

/* sized and panned in code to cover the screen at the painting's proportions */
.main-menu-art {
    position: absolute;
    background-size: 100% 100%;
}

.main-menu-shade {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-size: 100% 100%;
}

.main-menu-column {
    position: absolute;
    left: 7%;
    top: 0;
    bottom: 0;
    width: 470px;
    justify-content: center;
}

.main-menu-title {
    font-size: 78px;
    -unity-font-style: bold;
    color: rgb(244, 226, 170);
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.85);
    white-space: normal;
}

.main-menu-subtitle {
    font-size: 20px;
    -unity-font-style: italic;
    color: rgb(222, 216, 196);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    white-space: normal;
    margin: 0 0 34px 4px;
}

.main-menu-button {
    height: 56px;
    font-size: 22px;
    -unity-text-align: middle-left;
    padding-left: 24px;
}

.main-language {
    margin: 10px 0 6px 0;
}

.main-menu-credit {
    position: absolute;
    right: 18px;
    bottom: 12px;
    font-size: 13px;
    color: rgba(235, 230, 214, 0.75);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* ---------- New Game: realm cards, world and competitors ---------- */

.setup-columns {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.setup-column {
    min-height: 0;
}

.setup-realm-column {
    width: 46%;
    margin-right: 20px;
}

.setup-world-column {
    flex-grow: 1;
    flex-shrink: 1;
}

.setup-section {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(240, 210, 110);
    margin: 4px 0 6px 0;
}

.setup-realms {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 160px;
}

.setup-realm-group {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(185, 192, 178);
    margin: 8px 0 4px 2px;
}

.setup-realm-cards {
    flex-direction: row;
    flex-wrap: wrap;
}

.setup-realm {
    width: 32%;
    height: 54px;
    margin: 0 6px 6px 0;
    padding: 4px 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 2px;
    border-color: rgba(190, 154, 88, 0.25);
    border-radius: 5px;
}

.setup-realm:hover {
    border-color: rgb(230, 230, 230);
}

.setup-realm.selected {
    background-color: rgb(78, 70, 36);
    border-color: rgb(230, 190, 80);
}

.setup-realm .band {
    width: 24px;
    height: 34px;
    margin-right: 8px;
    flex-shrink: 0;
}

.setup-realm-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    color: rgb(240, 238, 228);
    white-space: normal;
    -unity-text-align: middle-left;
}

.setup-realm-taken {
    font-size: 11px;
    color: rgb(150, 190, 230);
    margin-left: 4px;
}

.setup-you {
    flex-direction: row;
    align-items: center;
    margin: 8px 0 6px 0;
}

.setup-realm-details {
    max-height: 200px;
    flex-shrink: 0;
}

.setup-realm-description {
    font-size: 14px;
    color: rgb(222, 224, 212);
    white-space: normal;
}

.setup-realm-animals {
    font-size: 13px;
    color: rgb(185, 192, 178);
    white-space: normal;
    margin-top: 6px;
}

.setup-world-column .setup-list {
    flex-grow: 1;
    max-height: none;
}

.setup-empty {
    font-size: 14px;
    color: rgb(185, 192, 178);
    margin: 8px 4px;
}

/* the competitor count is typed in, as well as stepped with − / + */
.setup-count {
    width: 64px;
    margin: 0 6px;
}

.setup-count .unity-base-field__input {
    font-size: 20px;
    -unity-text-align: middle-center;
    min-height: 32px;
}
