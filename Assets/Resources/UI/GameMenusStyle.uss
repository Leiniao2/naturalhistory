/* Natural History menus. Reference resolution 1920x1080 (scaled with screen size). */

.root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hidden {
    display: none;
}

/* ---------- HUD ---------- */

.top-bar {
    position: absolute;
    top: 12px;
    right: 12px;
    flex-direction: row;
    align-items: center;
}

.hud-button {
    height: 40px;
    min-width: 120px;
    margin-left: 8px;
    font-size: 17px;
    color: rgb(235, 232, 220);
    background-color: rgba(28, 36, 30, 0.88);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
}

.hud-button:hover {
    background-color: rgba(52, 70, 54, 0.95);
}

.ep-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 210, 110);
    padding: 6px 12px;
    background-color: rgba(28, 36, 30, 0.88);
    border-radius: 6px;
}

/* ---------- Panels ---------- */

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.panel {
    background-color: rgb(30, 38, 32);
    border-color: rgb(110, 130, 100);
    border-width: 2px;
    border-radius: 10px;
    padding: 24px;
}

.panel-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.menu-panel {
    width: 420px;
}

.menu-button {
    height: 52px;
    margin: 6px 0;
    font-size: 20px;
    color: rgb(235, 232, 220);
    background-color: rgb(52, 66, 54);
    border-width: 0;
    border-radius: 6px;
}

.menu-button:hover {
    background-color: rgb(76, 98, 78);
}

.menu-button:disabled {
    opacity: 0.4;
}

/* ---------- Save slots ---------- */

.slots-panel {
    width: 640px;
}

.slot-list {
    margin-bottom: 12px;
}

.slot-row {
    flex-direction: row;
    align-items: center;
    height: 76px;
    margin: 5px 0;
    padding: 0 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.slot-info {
    flex-grow: 1;
}

.slot-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(235, 232, 220);
}

.slot-detail {
    font-size: 15px;
    color: rgb(170, 180, 165);
}

.slot-button {
    width: 110px;
    height: 44px;
    margin-left: 8px;
    font-size: 17px;
    color: rgb(235, 232, 220);
    background-color: rgb(70, 100, 72);
    border-width: 0;
    border-radius: 6px;
}

.slot-button:hover {
    background-color: rgb(92, 130, 94);
}

.slot-button.danger {
    background-color: rgb(110, 50, 45);
}

.slot-button.danger:hover {
    background-color: rgb(140, 64, 56);
}

/* ---------- Trees ---------- */

.tree-panel {
    width: 90%;
    height: 86%;
    padding: 16px 20px;
}

.tree-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.tree-title {
    flex-grow: 1;
    -unity-text-align: middle-left;
    margin-bottom: 0;
}

.close-button {
    width: 44px;
    height: 44px;
    margin-left: 12px;
    font-size: 22px;
    color: rgb(235, 232, 220);
    background-color: rgb(60, 50, 46);
    border-width: 0;
    border-radius: 22px;
}

.close-button:hover {
    background-color: rgb(120, 60, 52);
}

.tree-scroll {
    flex-grow: 1;
    background-color: rgb(22, 28, 24);
    border-radius: 6px;
}

.tree-canvas {
    position: relative;
}

.tree-lines {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.tree-node {
    position: absolute;
    width: 200px;
    height: 66px;
    padding: 6px 10px;
    border-width: 2px;
    border-radius: 8px;
    justify-content: center;
    background-color: rgb(46, 50, 48);
    border-color: rgb(80, 86, 82);
}

.tree-node:hover {
    border-color: rgb(230, 230, 230);
}

.tree-node.selected {
    border-color: rgb(255, 255, 255);
    border-width: 3px;
}

.tree-node.unlocked {
    background-color: rgb(52, 104, 62);
    border-color: rgb(110, 180, 110);
}

.tree-node.available {
    background-color: rgb(78, 70, 36);
    border-color: rgb(230, 190, 80);
}

.tree-node.locked {
    opacity: 0.55;
}

.node-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 238, 228);
    white-space: normal;
}

.node-cost {
    font-size: 13px;
    color: rgb(200, 200, 185);
}

.tree-details {
    flex-direction: row;
    align-items: center;
    min-height: 110px;
    margin-top: 10px;
    padding: 10px 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.details-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.details-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.details-description {
    font-size: 16px;
    color: rgb(210, 214, 200);
    white-space: normal;
}

.details-meta {
    font-size: 14px;
    color: rgb(240, 210, 110);
    white-space: normal;
    margin-top: 4px;
}

.evolve-button {
    width: 160px;
    height: 56px;
    margin-left: 16px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    background-color: rgb(70, 120, 74);
    border-width: 0;
    border-radius: 6px;
}

.evolve-button:hover {
    background-color: rgb(90, 150, 94);
}

.evolve-button:disabled {
    opacity: 0.35;
}

/* ---------- Date bar ---------- */

.date-bar {
    position: absolute;
    top: 12px;
    left: 35%;
    right: 35%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.age-button {
    min-width: 260px;
    height: 56px;
    padding: 2px 16px;
    background-color: rgba(28, 36, 30, 0.9);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.age-button:hover {
    background-color: rgba(52, 70, 54, 0.95);
}

.age-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.date-label {
    font-size: 14px;
    color: rgb(190, 200, 180);
}

.end-turn-button {
    height: 56px;
    min-width: 130px;
    margin-left: 8px;
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(70, 120, 74);
    border-width: 0;
    border-radius: 6px;
}

.end-turn-button:hover {
    background-color: rgb(90, 150, 94);
}

.end-turn-button:disabled {
    opacity: 0.35;
}

/* ---------- Info panels ---------- */

.info-panel {
    position: absolute;
    bottom: 12px;
    width: 300px;
    padding: 10px 14px;
    background-color: rgba(28, 36, 30, 0.9);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
}

.world-panel {
    left: 12px;
}

.tile-panel {
    right: 12px;
}

.info-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    margin-bottom: 4px;
}

.info-zone {
    font-size: 16px;
    color: rgb(240, 210, 110);
    margin-bottom: 4px;
}

.info-stats {
    font-size: 15px;
    color: rgb(215, 220, 205);
    white-space: normal;
}

.info-note {
    font-size: 13px;
    -unity-font-style: italic;
    color: rgb(170, 185, 165);
    white-space: normal;
    margin-top: 4px;
}

/* ---------- Geologic timeline ---------- */

.age-panel {
    width: 80%;
    height: 82%;
    padding: 16px 20px;
}

.age-body {
    flex-grow: 1;
    flex-direction: row;
}

.age-list {
    width: 320px;
    margin-right: 14px;
}

.age-row {
    height: 58px;
    margin: 3px 0;
    padding: 4px 12px;
    justify-content: center;
    border-radius: 6px;
    border-left-width: 8px;
    background-color: rgb(40, 50, 42);
}

.age-row:hover {
    background-color: rgb(56, 70, 58);
}

.age-row.past {
    opacity: 0.7;
}

.age-row.future {
    opacity: 0.45;
}

.age-row.current {
    background-color: rgb(70, 92, 66);
}

.age-row.selected {
    border-right-width: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.age-row-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.age-row-range {
    font-size: 13px;
    color: rgb(180, 190, 172);
}

.age-details {
    flex-grow: 1;
    padding: 6px 14px;
    background-color: rgb(40, 50, 42);
    border-radius: 6px;
}

.age-name {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.age-range {
    font-size: 15px;
    color: rgb(240, 210, 110);
    margin-bottom: 8px;
}

.age-description {
    font-size: 17px;
    color: rgb(220, 224, 210);
    white-space: normal;
    margin-bottom: 8px;
}

.age-section {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(170, 210, 160);
    margin-top: 8px;
}

.age-text {
    font-size: 15px;
    color: rgb(210, 214, 200);
    white-space: normal;
}

/* ---------- Players ---------- */

.players-bar {
    position: absolute;
    top: 12px;
    left: 12px;
    flex-direction: column;
    align-items: flex-start;
}

.player-chip {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin: 0 0 4px 0;
    padding: 0 12px 0 6px;
    background-color: rgba(28, 36, 30, 0.88);
    border-color: rgb(110, 130, 100);
    border-width: 1px;
    border-radius: 6px;
}

.player-chip:hover {
    background-color: rgba(52, 70, 54, 0.95);
}

.player-chip.human {
    border-color: rgb(240, 210, 110);
    border-width: 2px;
}

.player-chip-name {
    font-size: 16px;
    color: rgb(235, 232, 220);
    margin-left: 8px;
}

.player-chip-tag {
    font-size: 12px;
    color: rgb(240, 210, 110);
    margin-left: 6px;
}

/* Two-colour band: primary over secondary */
.band {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    overflow: hidden;
    border-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
}

.band-half {
    flex-grow: 1;
}

.band-large {
    width: 40px;
    height: 40px;
    margin-right: 14px;
}

.faction-panel {
    width: 900px;
    height: 80%;
    padding: 16px 20px;
}

.faction-animals {
    flex-grow: 1;
    margin-top: 6px;
}

.animal-row {
    margin: 4px 0;
    padding: 8px 12px;
    border-radius: 6px;
    border-left-width: 6px;
    border-left-color: rgb(90, 100, 90);
    background-color: rgb(40, 50, 42);
}

.animal-row.active {
    border-left-color: rgb(120, 200, 110);
    background-color: rgb(50, 68, 50);
}

.animal-row.inactive {
    opacity: 0.6;
}

.animal-header {
    flex-direction: row;
    align-items: center;
}

.animal-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.animal-scientific {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(190, 200, 180);
    margin-left: 8px;
    flex-grow: 1;
}

.animal-status {
    font-size: 14px;
    color: rgb(240, 210, 110);
}

.animal-description {
    font-size: 15px;
    color: rgb(210, 214, 200);
    white-space: normal;
    margin-top: 2px;
}

/* ---------- New game ---------- */

.setup-panel {
    width: 1100px;
    max-height: 90%;
}

.setup-count-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.setup-count-label {
    font-size: 20px;
    color: rgb(235, 232, 220);
    margin-right: 12px;
}

.count-button {
    width: 40px;
    height: 40px;
    font-size: 22px;
    color: rgb(235, 232, 220);
    background-color: rgb(52, 66, 54);
    border-width: 0;
    border-radius: 6px;
}

.count-button:hover {
    background-color: rgb(76, 98, 78);
}

.setup-count {
    width: 48px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 210, 110);
    -unity-text-align: middle-center;
}

.spacer {
    flex-grow: 1;
}

.setup-list {
    flex-shrink: 1;
    max-height: 600px;
}

.setup-row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin: 3px 0;
    padding: 0 10px;
    border-radius: 6px;
    background-color: rgb(40, 50, 42);
}

.setup-seat {
    width: 70px;
    font-size: 16px;
    color: rgb(240, 210, 110);
}

.setup-band {
    width: 36px;
    height: 36px;
    margin: 0 12px 0 0;
    padding: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    overflow: hidden;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
}

.setup-faction {
    width: 260px;
    margin-right: 12px;
    font-size: 16px;
}

.setup-name {
    flex-grow: 1;
    margin-right: 12px;
    font-size: 16px;
}

.setup-category {
    width: 130px;
    font-size: 13px;
    color: rgb(180, 190, 172);
}

.setup-hint {
    font-size: 14px;
    color: rgb(170, 185, 165);
    white-space: normal;
    margin: 8px 0;
}

.setup-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.setup-action {
    width: 180px;
    margin-left: 10px;
}

.setup-action.start {
    background-color: rgb(63, 122, 68);
}

.setup-action.start:hover {
    background-color: rgb(80, 150, 85);
}

/* ---------- Toast ---------- */

.toast {
    position: absolute;
    bottom: 40px;
    left: 30%;
    right: 30%;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(240, 236, 220);
    padding: 10px;
    background-color: rgba(28, 36, 30, 0.92);
    border-radius: 8px;
}
