<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Styles: GameMenusStyle.uss (added by GameMenus.cs). Picking is disabled on full-screen
         containers so clicks pass through to the map except where there is actual UI. -->
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <!-- Top-right HUD -->
        <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
            <ui:Label name="ep-label" class="ep-label" text="EP 0" />
            <ui:Button name="morphology-button" class="hud-button" text="Functions" />
            <ui:Button name="ethology-button" class="hud-button" text="Behaviors" />
            <ui:Button name="zoology-button" class="hud-button" text="Evolution Tree" />
            <ui:Button name="menu-button" class="hud-button" text="Menu" />
        </ui:VisualElement>

        <!-- Admin tools under the top-right HUD (Editor / development builds; ` toggles) -->
        <ui:VisualElement name="admin-bar" class="admin-bar hidden">
            <ui:Label class="admin-tag" text="ADMIN" picking-mode="Ignore" />
            <ui:DropdownField name="admin-age" class="admin-age" label="Age" />
        </ui:VisualElement>

        <!-- Top-left: players and their colour bands (chips are created in code) -->
        <ui:VisualElement name="players-bar" class="players-bar" picking-mode="Ignore" />

        <!-- Top-centre: turn, period, date -->
        <ui:VisualElement name="date-bar" class="date-bar">
            <ui:Button name="age-button" class="age-button">
                <ui:Label name="age-label" class="age-label" text="Cambrian" picking-mode="Ignore" />
                <ui:Label name="date-label" class="date-label" text="538.8 Ma · Turn 1" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Bottom-left corner: overview map (MiniMap.cs) with the layer switch (sky / surface / underground) above it -->
        <ui:VisualElement name="minimap-dock" class="minimap-dock" picking-mode="Ignore">
            <ui:VisualElement name="layer-switch" class="layer-switch">
                <ui:Button name="sky-button" class="hud-button layer-button" text="Sky" />
                <ui:Button name="surface-button" class="hud-button layer-button" text="Surface" />
                <ui:Button name="under-button" class="hud-button layer-button" text="Underground" />
            </ui:VisualElement>
            <ui:VisualElement name="minimap" class="minimap" />
        </ui:VisualElement>

        <!-- Bottom-right: the animals on the selected tile (AnimalPanel.cs; a tab per group along
             its top when there are several), stacked over the selected tile itself -->
        <ui:VisualElement name="right-dock" class="right-dock" picking-mode="Ignore">
            <ui:VisualElement name="animal-box" class="animal-box" picking-mode="Ignore">
                <ui:VisualElement name="animal-tabs" class="animal-tabs hidden" />
                <ui:VisualElement name="animal-panel" class="info-panel animal-panel hidden">
                    <ui:VisualElement class="animal-head">
                        <ui:VisualElement name="animal-portrait" class="species-portrait animal-portrait" />
                        <ui:VisualElement class="animal-names">
                            <ui:Label name="animal-name" class="info-title" text="" />
                            <ui:Label name="animal-meta" class="animal-meta" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="animal-stats" class="info-stats" text="" />
                    <ui:Label name="animal-description" class="info-note" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tile-panel" class="info-panel tile-panel hidden">
                <ui:Label name="tile-title" class="info-title" text="Tile" />
                <ui:Label name="tile-zone" class="info-zone" text="" />
                <ui:Label name="tile-stats" class="info-stats" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom centre: the selected animal and its orders, and beside it the turn button, which
             reads "Next animal (n)" while any of yours await orders and "Next Turn" once all are done (UnitCycle) -->
        <ui:VisualElement name="unit-dock" class="unit-dock" picking-mode="Ignore">
            <!-- Selected animal of yours: species, and what it can do -->
            <ui:VisualElement name="unit-panel" class="unit-panel hidden">
                <ui:VisualElement name="unit-portrait" class="species-portrait unit-portrait" />
                <ui:VisualElement class="unit-info">
                    <ui:Label name="unit-name" class="unit-name" text="" />
                    <ui:Label name="unit-detail" class="unit-detail" text="" />
                    <ui:VisualElement class="unit-actions">
                        <ui:Button name="unit-functions" class="unit-button" text="Functions" />
                        <ui:Button name="unit-behaviors" class="unit-button" text="Behaviors" />
                        <ui:Button name="unit-reproduce" class="unit-button" text="Reproduce" />
                        <ui:Button name="unit-evolve" class="unit-button unit-evolve" text="Evolve" />
                        <!-- sit this turn out: the next animal awaiting orders comes up (UnitCycle) -->
                        <ui:Button name="unit-skip" class="unit-button unit-skip" text="Skip turn" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="end-turn-button" class="end-turn-button" text="Next Turn" />
        </ui:VisualElement>

        <!-- Geologic timeline: all periods, details of the selected one -->
        <ui:VisualElement name="age-overlay" class="overlay hidden">
            <ui:VisualElement class="panel age-panel">
                <ui:VisualElement class="tree-header">
                    <ui:Label name="age-panel-title" class="panel-title tree-title" text="Geologic Time" />
                    <ui:Button name="age-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement class="age-body">
                    <ui:ScrollView name="age-list" class="age-list" />
                    <ui:ScrollView class="age-details">
                        <ui:Label name="age-name" class="age-name" text="" />
                        <ui:Label name="age-range" class="age-range" text="" />
                        <!-- world averages now, shown for the current period only (ClimateHud, AgePanel) -->
                        <ui:VisualElement name="age-climate">
                            <ui:Label class="age-section" text="World Climate" />
                            <ui:Label name="world-stats" class="age-text" text="" />
                            <ui:Label name="world-note" class="info-note" text="" />
                        </ui:VisualElement>
                        <ui:Label name="age-description" class="age-description" text="" />
                        <ui:Label class="age-section" text="Key events" />
                        <ui:Label name="age-events" class="age-text" text="" />
                        <ui:Label class="age-section" text="Environment" />
                        <ui:Label name="age-environment" class="age-text" text="" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Pause menu -->
        <ui:VisualElement name="pause-overlay" class="overlay hidden">
            <ui:VisualElement class="panel menu-panel">
                <ui:Label class="panel-title" text="Natural History" />
                <ui:Button name="resume-button" class="menu-button" text="Resume" />
                <ui:Button name="encyclopedia-button" class="menu-button" text="Encyclopedia" />
                <ui:Button name="new-game-button" class="menu-button" text="New Game" />
                <ui:Button name="save-button" class="menu-button" text="Save Game" />
                <ui:Button name="load-button" class="menu-button" text="Load Game" />
                <ui:Button name="quit-button" class="menu-button" text="Quit to Desktop" />
                <ui:DropdownField name="language-dropdown" class="language-dropdown" label="Language" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Save / load slots (rows are created in code) -->
        <ui:VisualElement name="slots-overlay" class="overlay hidden">
            <ui:VisualElement class="panel slots-panel">
                <ui:Label name="slots-title" class="panel-title" text="Save Game" />
                <ui:VisualElement name="slot-list" class="slot-list" />
                <ui:Button name="slots-back-button" class="menu-button" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Functions (morphology) / Behaviors (ethology) tree of the focused species -->
        <ui:VisualElement name="tree-overlay" class="overlay hidden">
            <ui:VisualElement class="panel tree-panel">
                <ui:VisualElement class="tree-header">
                    <ui:Label name="tree-title" class="panel-title tree-title" text="Functions" />
                    <ui:Label name="tree-progress" class="tree-progress" text="" />
                    <ui:Label name="tree-ep-label" class="ep-label" text="EP 0" />
                    <ui:Button name="tree-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <!-- Whose trees these are: a tab per species of yours, to switch (SpeciesTabs) -->
                <ui:ScrollView name="tree-species-scroll" class="species-tabs-scroll" mode="Horizontal">
                    <ui:VisualElement name="tree-species-tabs" class="species-tabs" />
                </ui:ScrollView>
                <!-- One tab per branch (sub-tree); created in code -->
                <ui:ScrollView name="tree-branches-scroll" class="tree-branches-scroll" mode="Horizontal">
                    <ui:VisualElement name="tree-branches" class="tree-branches" />
                </ui:ScrollView>
                <ui:ScrollView name="tree-scroll" class="tree-scroll" mode="VerticalAndHorizontal">
                    <ui:VisualElement name="tree-canvas" class="tree-canvas" />
                </ui:ScrollView>
                <ui:VisualElement name="tree-details" class="tree-details">
                    <ui:VisualElement class="details-text">
                        <ui:Label name="details-name" class="details-name" text="Select a trait" />
                        <ui:Label name="details-description" class="details-description" text="" />
                        <ui:Label name="details-meta" class="details-meta" text="" />
                    </ui:VisualElement>
                    <ui:Button name="evolve-button" class="evolve-button" text="Acquire" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- A player's faction: colour band, description, iconic animals -->
        <ui:VisualElement name="faction-overlay" class="overlay hidden">
            <ui:VisualElement class="panel faction-panel">
                <ui:VisualElement class="tree-header">
                    <ui:VisualElement name="faction-band" class="band band-large" />
                    <ui:Label name="faction-title" class="panel-title tree-title" text="" />
                    <ui:Button name="faction-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <ui:Label name="faction-subtitle" class="age-range" text="" />
                <ui:Label name="faction-description" class="age-description" text="" />
                <ui:Label class="age-section" text="Iconic animals" />
                <ui:ScrollView name="faction-animals" class="faction-animals" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- New game: number of players, faction, name and colour band of each (rows are created in code) -->
        <ui:VisualElement name="setup-overlay" class="overlay hidden">
            <ui:VisualElement class="panel setup-panel">
                <ui:Label class="panel-title" text="New Game" />
                <ui:VisualElement class="setup-count-row">
                    <ui:Label class="setup-count-label" text="Players" />
                    <ui:Button name="setup-fewer" class="count-button" text="−" />
                    <ui:Label name="setup-count" class="setup-count" text="4" />
                    <ui:Button name="setup-more" class="count-button" text="+" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="setup-randomize" class="slot-button" text="Randomize" />
                </ui:VisualElement>
                <!-- Land area, game length and starting period (NewGameOptions) -->
                <ui:VisualElement name="setup-options" class="setup-options" />
                <ui:ScrollView name="setup-list" class="setup-list" />
                <ui:Label class="setup-hint" text="Click a colour band to change it. Names can be anything; the faction decides the iconic animals." />
                <ui:VisualElement class="setup-actions">
                    <ui:Button name="setup-back-button" class="menu-button setup-action" text="Back" />
                    <ui:Button name="setup-start-button" class="menu-button setup-action start" text="Start" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Evolution tree (ZoologyPanel): from one species to what it can become, and what each step requires -->
        <ui:VisualElement name="zoology-overlay" class="overlay hidden">
            <ui:VisualElement class="panel tree-panel">
                <ui:VisualElement class="tree-header">
                    <ui:Button name="zoology-back-button" class="hud-button zoology-back" text="Back" />
                    <ui:Label class="panel-title tree-title" text="Evolution Tree" />
                    <ui:Label name="zoology-subtitle" class="tree-progress" text="" />
                    <ui:Button name="zoology-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <ui:ScrollView name="zoology-species-scroll" class="species-tabs-scroll" mode="Horizontal">
                    <ui:VisualElement name="zoology-species-tabs" class="species-tabs" />
                </ui:ScrollView>
                <ui:VisualElement class="zoology-body">
                    <ui:ScrollView name="zoology-scroll" class="tree-scroll" mode="VerticalAndHorizontal">
                        <ui:VisualElement name="zoology-canvas" class="tree-canvas" />
                    </ui:ScrollView>
                    <ui:ScrollView class="zoology-details">
                        <ui:VisualElement class="zoology-detail-head">
                            <ui:VisualElement class="zoology-detail-names">
                                <ui:Label name="zoology-name" class="age-name" text="" />
                                <ui:Label name="zoology-meta" class="age-range" text="" />
                            </ui:VisualElement>
                            <!-- its portrait and description are in the Encyclopedia -->
                            <ui:Button name="zoology-encyclopedia-button" class="hud-button zoology-encyclopedia" text="Encyclopedia" />
                        </ui:VisualElement>
                        <ui:VisualElement name="zoology-links" class="zoology-links" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Encyclopedia (EncyclopediaPanel): every species of the game, its painting and description -->
        <ui:VisualElement name="encyclopedia-overlay" class="overlay hidden">
            <ui:VisualElement class="panel tree-panel">
                <ui:VisualElement class="tree-header">
                    <ui:Label class="panel-title tree-title" text="Encyclopedia" />
                    <ui:TextField name="encyclopedia-search" class="encyclopedia-search" />
                    <ui:Label name="encyclopedia-count" class="tree-progress" text="" />
                    <ui:Button name="encyclopedia-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement class="encyclopedia-body">
                    <ui:ListView name="encyclopedia-list" class="encyclopedia-list" />
                    <ui:ScrollView class="encyclopedia-entry">
                        <ui:VisualElement class="encyclopedia-top">
                            <ui:VisualElement name="encyclopedia-painting" class="encyclopedia-painting" />
                            <ui:VisualElement class="encyclopedia-facts">
                                <ui:Label name="encyclopedia-name" class="encyclopedia-name" text="" />
                                <ui:Label name="encyclopedia-scientific" class="encyclopedia-scientific" text="" />
                                <ui:Label name="encyclopedia-stats" class="encyclopedia-stats" text="" />
                                <ui:Button name="encyclopedia-tree-button" class="hud-button encyclopedia-tree-button" text="Evolution Tree" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="encyclopedia-description" class="encyclopedia-description" text="" />
                        <ui:VisualElement name="encyclopedia-relatives" class="encyclopedia-relatives" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="toast" class="toast hidden" text="" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
