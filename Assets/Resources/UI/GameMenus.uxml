<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Styles: GameMenusStyle.uss (added by GameMenus.cs). Picking is disabled on full-screen
         containers so clicks pass through to the map except where there is actual UI. -->
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <!-- Top-right HUD -->
        <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
            <ui:Label name="ep-label" class="ep-label" text="EP 0" />
            <ui:Button name="morphology-button" class="hud-button" text="Morphology" />
            <ui:Button name="ethology-button" class="hud-button" text="Ethology" />
            <ui:Button name="menu-button" class="hud-button" text="Menu" />
        </ui:VisualElement>

        <!-- Top-left: players and their colour bands (chips are created in code) -->
        <ui:VisualElement name="players-bar" class="players-bar" picking-mode="Ignore" />

        <!-- Top-centre: turn, period, date -->
        <ui:VisualElement name="date-bar" class="date-bar">
            <ui:Button name="age-button" class="age-button">
                <ui:Label name="age-label" class="age-label" text="Cambrian" picking-mode="Ignore" />
                <ui:Label name="date-label" class="date-label" text="538.8 Ma · Turn 1" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="end-turn-button" class="end-turn-button" text="End Turn" />
        </ui:VisualElement>

        <!-- Bottom-left: world averages -->
        <ui:VisualElement name="world-panel" class="info-panel world-panel">
            <ui:Label class="info-title" text="World Climate" />
            <ui:Label name="world-stats" class="info-stats" text="" />
            <ui:Label name="world-note" class="info-note" text="" />
        </ui:VisualElement>

        <!-- Bottom-right: selected tile -->
        <ui:VisualElement name="tile-panel" class="info-panel tile-panel hidden">
            <ui:Label name="tile-title" class="info-title" text="Tile" />
            <ui:Label name="tile-zone" class="info-zone" text="" />
            <ui:Label name="tile-stats" class="info-stats" text="" />
        </ui:VisualElement>

        <!-- Geologic timeline: all periods, details of the selected one -->
        <ui:VisualElement name="age-overlay" class="overlay hidden">
            <ui:VisualElement class="panel age-panel">
                <ui:VisualElement class="tree-header">
                    <ui:Label name="age-panel-title" class="panel-title tree-title" text="Geologic Time" />
                    <ui:Button name="age-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement class="age-body">
                    <ui:ScrollView name="age-list" class="age-list" />
                    <ui:ScrollView class="age-details">
                        <ui:Label name="age-name" class="age-name" text="" />
                        <ui:Label name="age-range" class="age-range" text="" />
                        <ui:Label name="age-description" class="age-description" text="" />
                        <ui:Label class="age-section" text="Key events" />
                        <ui:Label name="age-events" class="age-text" text="" />
                        <ui:Label class="age-section" text="Environment" />
                        <ui:Label name="age-environment" class="age-text" text="" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Pause menu -->
        <ui:VisualElement name="pause-overlay" class="overlay hidden">
            <ui:VisualElement class="panel menu-panel">
                <ui:Label class="panel-title" text="Natural History" />
                <ui:Button name="resume-button" class="menu-button" text="Resume" />
                <ui:Button name="new-game-button" class="menu-button" text="New Game" />
                <ui:Button name="save-button" class="menu-button" text="Save Game" />
                <ui:Button name="load-button" class="menu-button" text="Load Game" />
                <ui:Button name="quit-button" class="menu-button" text="Quit to Desktop" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Save / load slots (rows are created in code) -->
        <ui:VisualElement name="slots-overlay" class="overlay hidden">
            <ui:VisualElement class="panel slots-panel">
                <ui:Label name="slots-title" class="panel-title" text="Save Game" />
                <ui:VisualElement name="slot-list" class="slot-list" />
                <ui:Button name="slots-back-button" class="menu-button" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Morphology / Ethology tree -->
        <ui:VisualElement name="tree-overlay" class="overlay hidden">
            <ui:VisualElement class="panel tree-panel">
                <ui:VisualElement class="tree-header">
                    <ui:Label name="tree-title" class="panel-title tree-title" text="Morphology" />
                    <ui:Label name="tree-ep-label" class="ep-label" text="EP 0" />
                    <ui:Button name="tree-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <ui:ScrollView name="tree-scroll" class="tree-scroll" mode="VerticalAndHorizontal">
                    <ui:VisualElement name="tree-canvas" class="tree-canvas" />
                </ui:ScrollView>
                <ui:VisualElement name="tree-details" class="tree-details">
                    <ui:VisualElement class="details-text">
                        <ui:Label name="details-name" class="details-name" text="Select a trait" />
                        <ui:Label name="details-description" class="details-description" text="" />
                        <ui:Label name="details-meta" class="details-meta" text="" />
                    </ui:VisualElement>
                    <ui:Button name="evolve-button" class="evolve-button" text="Evolve" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- A player's faction: colour band, description, iconic animals -->
        <ui:VisualElement name="faction-overlay" class="overlay hidden">
            <ui:VisualElement class="panel faction-panel">
                <ui:VisualElement class="tree-header">
                    <ui:VisualElement name="faction-band" class="band band-large" />
                    <ui:Label name="faction-title" class="panel-title tree-title" text="" />
                    <ui:Button name="faction-close-button" class="close-button" text="✕" />
                </ui:VisualElement>
                <ui:Label name="faction-subtitle" class="age-range" text="" />
                <ui:Label name="faction-description" class="age-description" text="" />
                <ui:Label class="age-section" text="Iconic animals" />
                <ui:ScrollView name="faction-animals" class="faction-animals" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- New game: number of players, faction, name and colour band of each (rows are created in code) -->
        <ui:VisualElement name="setup-overlay" class="overlay hidden">
            <ui:VisualElement class="panel setup-panel">
                <ui:Label class="panel-title" text="New Game" />
                <ui:VisualElement class="setup-count-row">
                    <ui:Label class="setup-count-label" text="Players" />
                    <ui:Button name="setup-fewer" class="count-button" text="−" />
                    <ui:Label name="setup-count" class="setup-count" text="4" />
                    <ui:Button name="setup-more" class="count-button" text="+" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="setup-randomize" class="slot-button" text="Randomize" />
                </ui:VisualElement>
                <ui:ScrollView name="setup-list" class="setup-list" />
                <ui:Label class="setup-hint" text="Click a colour band to change it. Names can be anything; the faction decides the iconic animals." />
                <ui:VisualElement class="setup-actions">
                    <ui:Button name="setup-back-button" class="menu-button setup-action" text="Back" />
                    <ui:Button name="setup-start-button" class="menu-button setup-action start" text="Start" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="toast" class="toast hidden" text="" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
